{
  "schemaVersion": 1,
  "id": "reactions",
  "version": "${version}",
  "name": "Reactions",
  "description": "A mod that adds dynamic expressions and facial personality to players.",
  "authors": [
    "Tochuuu"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/playereactions",
    "sources": "https://github.com/Tochuuu/Reactions",
    "issues": "https://github.com/Tochuuu/Reactions/issues"
  },
  "license": "GPL-3.0",
  "icon": "icon.png",
  "environment": "client",
  "entrypoints": {
    "main": [
      "me.tochuuu.reactions.fabric.ReactionsFabric"
    ],
    "client": [
      "me.tochuuu.reactions.fabric.client.ReactionsFabricClient"
    ],
    "modmenu": [
      "me.tochuuu.reactions.fabric.client.modmenu.ReactionsModMenu"
    ]
  },
  "mixins": [
    "reactions.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.2",
    "minecraft": ">=1.21 <1.21.4",
    "java": ">=21",
